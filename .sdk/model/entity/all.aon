# Entity: all

main: kit: entity: all: {

  alias: field: {}

  fields: [
    {
      name: "name"
      req: false
      short: "The name of the logo"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The URL to access the logo"
      type: "`$STRING`"
    }
    {
      name: "variants"
      req: false
      short: "Available variants for the logo"
      type: "`$ARRAY`"
    }
    {
      name: "versions"
      req: false
      short: "Available color versions for the logo"
      type: "`$ARRAY`"
    }
  ]

  name: "all"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/all"
          segments: [
            {
              lit: "all"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
